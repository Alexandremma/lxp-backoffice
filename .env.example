# =============================================================================
# lxp-backoffice — variáveis de ambiente (Vite)
# Copie para .env e preencha os valores. Nunca commitar .env com segredos reais.
# Lista operacional: docs/entrega/03-secrets-e-edges.md
# =============================================================================

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Alice / EaDStock — catálogo no vínculo de disciplina (obrigatório em homolog/prod) ---
# Par de chaves com prefixo "backoffice-" (fornecido pela B42).
# IMPORTANTE: só a URL na linha abaixo, sem texto extra colado do editor.
VITE_ALICE_BASE_URL=https://alice.eadstock.com.br
VITE_ALICE_API_KEY=
VITE_ALICE_API_SECRET=

# --- Auth — redirects de redefinição de senha ---
# Homolog backoffice: https://lxp-backoffice.vercel.app/admin/definir-senha
VITE_BACKOFFICE_SET_PASSWORD_URL=
# Homolog alunos (admin dispara reset de senha do aluno):
VITE_LXP_ALUNOS_SET_PASSWORD_URL=

# --- Certificados — QR e link de validação apontam para o portal do aluno ---
# Homolog: https://lxp-alunos.vercel.app
VITE_LXP_ALUNOS_PUBLIC_ORIGIN=

# --- Links úteis (opcional — exibição em telas admin) ---
# VITE_LXP_ALUNOS_LOGIN_URL=https://lxp-alunos.vercel.app/login
